<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CreatorMauiApp.ViewModels"
             xmlns:models="clr-namespace:CreatorMauiApp.Models"
             x:Class="CreatorMauiApp.Views.PlaylistsPage"
             x:DataType="vm:PlaylistsViewModel"
             Title="Playlists">
    <ScrollView>
        <VerticalStackLayout Spacing="14">
            <Label Text="Gerenciar Playlists"
                   Style="{StaticResource TitleLabelStyle}" />
            <Label Text="Curadoria rápida usando listas simuladas."
                   Style="{StaticResource BodyLabelStyle}" />

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout>
                    <Entry Placeholder="Nome da nova playlist" Text="{Binding NewPlaylistName}" />
                    <Button Text="Criar Playlist"
                            Command="{Binding CreatePlaylistCommand}" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="{Binding StatusMessage}"
                   Style="{StaticResource BodyLabelStyle}"
                   TextColor="{StaticResource SecondaryColor}" />

            <CollectionView ItemsSource="{Binding Playlists}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Nenhuma playlist cadastrada."
                           Style="{StaticResource BodyLabelStyle}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaylistItemModel">
                        <Frame Style="{StaticResource CardFrameStyle}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                                <Label Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Name}" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource TextPrimaryColor}" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding ContentCount, StringFormat='{0} conteúdos'}" TextColor="{StaticResource TextSecondaryColor}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding UpdatedAt, StringFormat='Atualizada {0:dd MMM HH:mm}'}" HorizontalTextAlignment="End" TextColor="{StaticResource TextSecondaryColor}" />
                                <StackLayout Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                    <Button Text="Editar"
                                            BackgroundColor="{StaticResource SecondaryColor}"
                                            Command="{Binding BindingContext.EditPlaylistCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Excluir"
                                            BackgroundColor="{StaticResource DangerColor}"
                                            Command="{Binding BindingContext.DeletePlaylistCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                </StackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
