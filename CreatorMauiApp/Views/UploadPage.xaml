<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CreatorMauiApp.ViewModels"
             x:Class="CreatorMauiApp.Views.UploadPage"
             x:DataType="vm:UploadViewModel"
             Title="Upload">
    <ScrollView>
        <VerticalStackLayout Spacing="14">
            <Label Text="Upload de Conteúdo"
                   Style="{StaticResource TitleLabelStyle}" />
            <Label Text="Preencha os dados do novo episódio e envie para revisão."
                   Style="{StaticResource BodyLabelStyle}" />

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout>
                    <Entry Placeholder="Título do conteúdo" Text="{Binding Title}" />
                    <Picker Title="Tipo de conteúdo"
                            ItemsSource="{Binding AvailableTypes}"
                            SelectedItem="{Binding SelectedType}" />
                    <Entry Placeholder="Arquivo selecionado" Text="{Binding FileName}" />
                    <Button Text="Enviar"
                            Command="{Binding SubmitCommand}" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="{Binding ConfirmationMessage}"
                   Style="{StaticResource BodyLabelStyle}"
                   TextColor="{StaticResource SuccessColor}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
