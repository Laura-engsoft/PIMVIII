<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui">
    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource NeutralBackground}" />
        <Setter Property="Padding" Value="24,36" />
    </Style>

    <Style TargetType="Label" x:Key="TitleLabelStyle">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style TargetType="Label" x:Key="BodyLabelStyle">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondaryColor}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondaryColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource NeutralSurface}" />
        <Setter Property="Margin" Value="0,4,0,12" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource NeutralSurface}" />
        <Setter Property="Margin" Value="0,4,0,12" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style TargetType="Frame" x:Key="CardFrameStyle">
        <Setter Property="BackgroundColor" Value="{StaticResource NeutralSurface}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="BorderColor" Value="{StaticResource NeutralBorder}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
</ResourceDictionary>
